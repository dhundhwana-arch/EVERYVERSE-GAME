; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="LIFEVERSE 2070"
config/description="Open World Life Simulation & Virtual Society — CREATED BY DIVYESH BAMBHANIYA"
config/features=PackedStringArray("4.3", "Mobile")

[autoload]

GameManager="*res://scripts/GameManager.gd"
ApiClient="*res://scripts/ApiClient.gd"

[internationalization]

locale/translations=PackedStringArray("res://localization/messages.en.translation", "res://localization/messages.gu.translation", "res://localization/messages.hi.translation")

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
